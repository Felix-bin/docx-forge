{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docx-forge.local/schemas/template.schema.json",
  "title": "docx-forge template manifest (template.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "kind", "genre", "language", "source",
    "content_anchor", "style_map", "heading_levels", "sections"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["format", "document"] },
    "genre": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "ingested_at"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "ingested_at": { "type": "string", "format": "date-time" }
      }
    },
    "content_anchor": { "type": "string", "pattern": "^\\{\\{.+\\}\\}$" },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "required"],
        "properties": {
          "type": { "enum": ["text", "multiline", "date"] },
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "style_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraph"],
      "properties": {
        "paragraph": {
          "allOf": [
            { "$ref": "#/$defs/roleMap" },
            { "required": ["h1", "body"] }
          ]
        },
        "character": { "$ref": "#/$defs/roleMap" },
        "table": { "$ref": "#/$defs/roleMap" }
      }
    },
    "heading_levels": { "type": "integer", "minimum": 1, "maximum": 9 },
    "numbering": {
      "type": "object",
      "propertyNames": { "pattern": "^h[1-9]$" },
      "additionalProperties": { "type": "string" }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "table": { "$ref": "#/$defs/caption" },
        "figure": { "$ref": "#/$defs/caption" }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "page_number_format"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "page_number_format": { "enum": ["arabic", "roman_lower", "roman_upper", "none"] },
          "start_at": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "fixed_regions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_pages": { "type": "integer", "minimum": 1 }
      }
    },
    "skeleton": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "level", "required"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "level": { "type": "integer", "minimum": 1, "maximum": 9 },
          "required": { "type": "boolean" },
          "guidance": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "format" } } },
      "then": { "properties": { "skeleton": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "styleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "roleMap": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/styleRef" }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "position"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "position": { "enum": ["above", "below"] },
        "include_chapter": { "type": "boolean" }
      }
    }
  }
}
